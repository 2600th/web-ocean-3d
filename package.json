{
  "name": "web-ocean-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Production-quality WebGPU/TSL ocean experience built with Three.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "bench": "npm run build && node scripts/benchmark.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.0",
    "@webgpu/types": "^0.1.71",
    "babylonpress-ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^1.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
